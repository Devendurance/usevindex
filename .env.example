# Vindex — server environment. Copy to .env and fill in.
# Server secrets must never be exposed through NEXT_PUBLIC_* variables.

# Base Sepolia JSON-RPC endpoint for canonical chain reads.
# Public endpoint: https://sepolia.base.org
BASE_SEPOLIA_RPC_URL=https://base-sepolia-rpc.publicnode.com

# Optional: comma/space-separated fallback RPC endpoints (read-only failover,
# chain-verified against 84532). Never used as a write path.
BASE_SEPOLIA_FALLBACK_RPC_URLS=https://base-sepolia.drpc.org

# PostgreSQL connection string (managed provider friendly, e.g. Supabase/Neon).
# Server-only; never expose client-side.
DATABASE_URL=postgres://user:password@host:5432/vindex

# KeeperHub organization API key (kh_ prefix).
# Create at https://app.keeperhub.com -> avatar -> API Keys -> Organisation.
KEEPERHUB_API_KEY=kh_replace_with_your_organisation_key

# Optional: override KeeperHub API base URL (default https://app.keeperhub.com)
# KEEPERHUB_API_BASE_URL=https://app.keeperhub.com
